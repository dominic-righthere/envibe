{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dominic-righthere/envibe",
  "description": "Secure permission layer between AI agents and your .env files",
  "repository": {
    "url": "https://github.com/dominic-righthere/envibe",
    "source": "github"
  },
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "envibe",
      "version": "0.3.0",
      "transport": { "type": "stdio" },
      "packageArguments": [
        { "type": "positional", "value": "mcp" }
      ]
    }
  ]
}
