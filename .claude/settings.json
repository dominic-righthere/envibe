{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(./.envibe/**)",
      "Edit(./.envibe/**)",
      "Write(./.envibe/**)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(head .env:*)",
      "Bash(head ./.env:*)",
      "Bash(tail .env:*)",
      "Bash(tail ./.env:*)",
      "Bash(less .env:*)",
      "Bash(less ./.env:*)",
      "Bash(more .env:*)",
      "Bash(more ./.env:*)",
      "Bash(grep .env:*)",
      "Bash(grep ./.env:*)",
      "Bash(cat .envibe/:*)",
      "Bash(cat ./.envibe/:*)",
      "Bash(head .envibe/:*)",
      "Bash(tail .envibe/:*)",
      "Bash(less .envibe/:*)",
      "Bash(more .envibe/:*)",
      "Bash(grep .envibe/:*)"
    ],
    "allow": [
      "Read(./.env.ai)",
      "Read(./.env.manifest.yaml)",
      "Read(./.env.example)"
    ]
  }
}
